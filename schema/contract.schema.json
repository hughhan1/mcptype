{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hughhan1/mcptype/main/schema/contract.schema.json",
  "title": "mcptype contract metadata",
  "type": "object",
  "required": ["version", "identity"],
  "properties": {
    "version": {"const": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "contract": {"$ref": "#/$defs/contract"},
    "requires": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/expectation"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "schema": {"type": "object"},
    "tool": {
      "type": "object",
      "required": ["name", "inputSchema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "inputSchema": {"allOf": [{"$ref": "#/$defs/schema"}], "properties": {"type": {"const": "object"}}, "required": ["type"]},
        "outputSchema": {"$ref": "#/$defs/schema"}
      }
    },
    "resource": {
      "type": "object",
      "required": ["uri", "outputSchema"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "outputSchema": {"$ref": "#/$defs/schema"}
      }
    },
    "contract": {
      "type": "object",
      "required": ["tools"],
      "properties": {
        "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
      }
    },
    "expectation": {
      "type": "object",
      "required": ["identity", "contract"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "contract": {"$ref": "#/$defs/contract"}
      }
    }
  }
}
